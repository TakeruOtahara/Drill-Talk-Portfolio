# --- Auth Keys ---
# Docker Compose とバックエンドが使用
DRILLTALK_API_KEY=
# Next.js のビルド時に焼き固める用（上と同じ値を入力）
NEXT_PUBLIC_DRILLTALK_API_KEY=
# Google Gemini API Key
GEMINI_API_KEY=

# --- Network Settings ---
# バックエンドの許可リスト（ローカル開発用をデフォルトで記載）
ALLOWED_ORIGINS_RAW=http://localhost:3000
# フロントエンドが繋ぎに行くWebSocketのホスト
NEXT_PUBLIC_WS_URL=localhost:8000
