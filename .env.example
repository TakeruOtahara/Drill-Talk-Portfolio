# --- Auth Keys ---
# Next.js(BFF)がAPIMの城壁を通るための合言葉（ローカルにはAPIMが存在しないため）
DRILLTALK_API_KEY=your_secret_key_here
# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# --- Network Settings ---
# Next.jsがルーティングする「本当の宛先（APIM または ローカルFastAPI）」
BACKEND_URL=http://localhost:8000
# Next.js(BFF)がアクセスを許可するOrigin（CSWSH対策用）
ALLOWED_ORIGINS_RAW=http://localhost:3000
