# --- Auth Keys (Local Development Only) ---
# BFF(Next.js)とバックエンド(FastAPI)間の相互認証用シークレット
# ※本番環境では Azure Key Vault からセキュアに注入されます
DRILLTALK_API_KEY=your_secret_key_here

# Google Gemini API 認証キー
# ※本番環境では Azure Key Vault (Secret Reference) を使用
GEMINI_API_KEY=your_gemini_api_key_here

# --- Network Settings ---
# バックエンドAPIの接続先URL
# ローカル: localhost:8000 / 本番: Azure Container Apps 内部FQDN
BACKEND_URL=http://localhost:8000

# CORS/CSWSH対策: フロントエンドからのアクセスのみを許可するOriginリスト
ALLOWED_ORIGINS_RAW=http://localhost:3000
